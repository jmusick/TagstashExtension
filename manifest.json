{
  "manifest_version": 3,
  "name": "Tagstash",
  "version": "0.1.0",
  "description": "Save the current tab to your Tagstash bookmark manager.",
  "permissions": ["storage", "tabs", "activeTab", "scripting"],
  "host_permissions": [
    "https://tagstash.pages.dev/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Save to Tagstash",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tagstash@orboro.net",
      "strict_min_version": "128.0"
    }
  },
  "data_collection_permissions": {
    "required": [
      "authentication_info",
      "browsing_history"
    ],
    "optional": []
  }
}
