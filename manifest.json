{
  "manifest_version": 3,
  "name": "Tagsta.sh",
  "version": "1.1.0",
  "description": "Save the current tab to your Tagsta.sh bookmark manager.",
  "permissions": ["storage", "tabs", "activeTab", "scripting"],
  "host_permissions": [
    "https://tagsta.sh/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Save to Tagsta.sh",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tagstash@orboro.net",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "browsingActivity"
        ],
        "optional": [
          "technicalAndInteraction"
        ]
      }
    }
  }
}
